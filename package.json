{
  "name": "identity-prism",
  "version": "1.0.0-hardened",
  "description": "Unified Identity Prism OS: RAG Intelligence + Digital Twin Memory (Hardened v1.0)",
  "type": "module",
  "imports": {
    "@/*": "./src/*"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run prisma:generate && next build",
    "start": "next start",
    "lint": "eslint ./src --ext .js,.ts,.tsx",
    "test": "tsx --test test/hardening/*.test.ts test/user-flows/*.test.ts",
    "seed:profile": "tsx scripts/run-seed.ts",
    "postinstall": "npm run prisma:generate",
    "prisma:generate:mongo": "prisma generate --schema=prisma/mongo/schema.prisma",
    "prisma:generate:pg": "prisma generate --schema=prisma/postgres/schema.prisma",
    "prisma:generate": "npm run prisma:generate:mongo && npm run prisma:generate:pg",
    "prisma:migrate:pg": "prisma migrate dev --schema=prisma/postgres/schema.prisma",
    "security:scan": "bash scripts/scan-secrets.sh"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@ai-sdk/openai": "^1.3.22",
    "@ai-sdk/react": "^1.2.12",
    "@langchain/classic": "^1.0.31",
    "@langchain/community": "^1.1.27",
    "@langchain/core": "^1.0.1",
    "@langchain/mongodb": "^1.1.0",
    "@langchain/openai": "^1.4.4",
    "@langchain/textsplitters": "^1.0.1",
    "@prisma/client": "^6.19.3",
    "@sanity/client": "^7.23.0",
    "@sanity/vision": "^6.2.0",
    "@vercel/analytics": "latest",
    "@vercel/blob": "^2.4.0",
    "@vercel/functions": "^3.4.3",
    "@vercel/sandbox": "latest",
    "@web-std/file": "^3.0.3",
    "ai": "^6.0.188",
    "axios": "^1.6.7",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "filepond": "^4.30.6",
    "framer-motion": "^12.38.0",
    "langchain": "^1.3.3",
    "langfuse": "^3.38.20",
    "lucide-react": "^0.300.0",
    "mongodb": "^7.1.1",
    "mongoose": "^9.4.1",
    "multer": "^2.1.1",
    "next": "^15.2.4",
    "next-sanity": "^13.1.1",
    "node-cron": "^3.0.3",
    "openai": "^6.34.0",
    "pdf-parse": "^1.1.1",
    "pdf2json": "^3.0.5",
    "pdfjs-dist": "^4.0.379",
    "pdfreader": "^3.0.8",
    "prisma": "^6.19.3",
    "react": "^18",
    "react-dom": "^18",
    "react-filepond": "^7.1.2",
    "react-router-dom": "^6.22.1",
    "react-toastify": "^10.0.4",
    "sanity": "^6.2.0",
    "styled-components": "^6.4.3",
    "uuid": "^9.0.1",
    "workflow": "^4.2.4"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.2.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "autoprefixer": "^10.0.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.2.4",
    "postcss": "^8",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.3.0",
    "tsx": "^4.19.4",
    "typescript": "^5"
  },
  "overrides": {
    "mongodb": "^7.1.1"
  }
}
