generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/postgres"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Neon (Vercel integration) exposes brain_*-prefixed vars; there is no plain
  // DATABASE_URL. Use the Prisma-tuned pooled URL at runtime and the unpooled
  // URL for migrations. Falls back to DATABASE_URL if a plain one is provided.
  url       = env("brain_POSTGRES_PRISMA_URL")
  directUrl = env("brain_POSTGRES_URL_NON_POOLING")
}

model DecisionLog {
  id           String   @id @default(uuid())
  userId       String
  mode         String   // architect | founder | operator

  contextJson  Json
  outputJson   Json

  confidence   Float
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@map("decision_logs")
}

model FeedbackLog {
  id           String   @id @default(uuid())
  decisionId   String
  userId       String
  feedbackType String   // accepted | ignored | rejected
  comment      String?
  createdAt    DateTime @default(now())

  @@index([decisionId])
  @@index([userId])
  @@map("feedback_logs")
}

// L3 Opportunity Engine — stores every /cognitive/evaluate run
model OpportunityEvaluation {
  id             String   @id @default(uuid())
  userId         String
  inputText      String   // the JD, brief, or idea text submitted
  evaluationJson Json     // full output: fit_score, verdict, why_yes, why_no, action_items
  fitScore       Float    @default(0.0)
  mode           String   @default("architect")
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@map("opportunity_evaluations")
}

model BehaviorModel {
  id          String   @id @default(uuid())
  userId      String
  modelType   String   // decision_model | habit_model | attention_model
  key         String
  value       Json
  confidence  Float    @default(0.5)
  occurrences Int      @default(1)
  sourceIds   String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, modelType, key])
  @@map("behavior_models")
}

model TraitScore {
  id          String   @id @default(uuid())
  userId      String
  trait       String   // analytical | reactive | structured | etc.
  score       Float
  confidence  Float    @default(0.5)
  occurrences Int      @default(1)
  sourceIds   String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, trait])
  @@map("trait_scores")
}

model Preference {
  id          String   @id @default(uuid())
  userId      String
  category    String   // communication | work | content | scheduling
  key         String
  value       Json
  explicit    Boolean  @default(false)
  confidence  Float    @default(0.6)
  occurrences Int      @default(1)
  sourceIds   String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, category, key])
  @@map("preferences")
}

model StylePattern {
  id         String   @id @default(uuid())
  userId     String
  pattern    String   // e.g. "removes passive voice"
  frequency  Int      @default(1)
  confidence Float    @default(0.5)
  lastSeen   DateTime @default(now())

  @@unique([userId, pattern])
  @@map("style_patterns")
}

model PersonaProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  displayName        String?
  communicationStyle Json?
  writingStyle       Json?
  decisionStyle      Json?
  confidenceScore    Float    @default(0.5)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("persona_profiles")
}

model BehavioralTrait {
  id            String   @id @default(uuid())
  userId        String
  traitName     String
  traitValue    Float    @default(0.5)
  confidence    Float    @default(0.5)
  evidenceCount Int      @default(0)
  sourceLayer   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, traitName])
  @@index([userId])
  @@map("behavioral_traits")
}

model CommunicationPattern {
  id           String   @id @default(uuid())
  userId       String
  patternType  String?
  patternValue Json?
  confidence   Float    @default(0.5)
  sampleCount  Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([userId, patternType])
  @@map("communication_patterns")
}

model PreferenceMemory {
  id         String   @id @default(uuid())
  userId     String
  category   String?
  key        String?
  value      Json?
  confidence Float    @default(0.5)
  source     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([userId, category, key])
  @@map("preference_memory")
}

model OutputFingerprint {
  id               String   @id @default(uuid())
  userId           String
  sourceType       String?
  sourceId         String?
  styleVector      Json?
  aiProbability    Float    @default(0)
  humanProbability Float    @default(1)
  verifiedHuman    Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@index([userId])
  @@index([userId, sourceType, sourceId])
  @@map("output_fingerprints")
}

model PersonaEvolutionLog {
  id              String   @id @default(uuid())
  userId          String
  changedField    String?
  oldValue        Json?
  newValue        Json?
  reason          String?
  confidenceDelta Float?
  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
  @@map("persona_evolution_logs")
}

model FeedbackMemory {
  id           String   @id @default(uuid())
  userId       String
  targetType   String?
  targetId     String?
  feedbackType String?
  notes        String?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([userId, targetType, targetId])
  @@map("feedback_memory")
}

model AdaptiveUxProfile {
  id                       String   @id @default(uuid())
  userId                   String   @unique
  uiDensity                String   @default("minimal")
  preferredMode            String?
  preferredOutputLength    String?
  preferredNavigationStyle String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@map("adaptive_ux_profiles")
}

model PublishingQueue {
  id          String   @id @default(uuid())
  userId      String
  outputId    String
  platform    String
  status      String   @default("pending")
  scheduledAt DateTime?
  publishedAt DateTime?
  retryCount  Int      @default(0)
  lastError   String?
  createdAt   DateTime @default(now())

  @@index([userId, status])
  @@map("publishing_queue")
}

model PublishedOutput {
  id               String   @id @default(uuid())
  userId           String
  outputId         String
  platform         String?
  externalId       String?
  externalUrl      String?
  publishedContent Json?
  analytics        Json?
  createdAt        DateTime @default(now())

  @@index([userId, platform])
  @@map("published_outputs")
}

model WorkflowLog {
  id           String   @id @default(uuid())
  workflowName String?
  status       String?
  payload      Json?
  error        String?
  createdAt    DateTime @default(now())

  @@index([workflowName, createdAt])
  @@map("workflow_logs")
}

model ExternalFeedback {
  id             String   @id @default(uuid())
  userId         String
  platform       String?
  externalPostId String?
  feedbackType   String?
  payload        Json?
  createdAt      DateTime @default(now())

  @@index([userId, platform])
  @@map("external_feedback")
}

model AutomationRule {
  id          String   @id @default(uuid())
  userId      String
  triggerType String?
  conditions  Json?
  action      Json?
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([userId, enabled])
  @@map("automation_rules")
}

model SchedulerState {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json?
  updatedAt DateTime @updatedAt

  @@map("scheduler_state")
}

model RetryQueue {
  id          String   @id @default(uuid())
  queueType   String
  refId       String
  status      String   @default("pending")
  retryCount  Int      @default(0)
  nextRetryAt DateTime?
  lastError   String?
  createdAt   DateTime @default(now())

  @@index([queueType, status])
  @@map("retry_queue")
}

model ExecutionAuditLog {
  id        String   @id @default(uuid())
  userId    String?
  eventType String
  payload   Json?
  status    String?
  createdAt DateTime @default(now())

  @@index([eventType, createdAt])
  @@map("execution_audit_logs")
}

model OutputLog {
  id              String   @id @default(uuid())
  userId          String
  decisionId      String?  // Link to L3 decision
  platform        String   // linkedin | blog | memo | other
  content         String
  status          String   @default("draft") // draft | pushed
  personaSnapshot Json?    // Snapshot of L4 traits used for this generation
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([decisionId])
  @@map("output_logs")
}

// Public profile — the world-facing serving surface (Neon, L5 output).
// Moved here from the Mongo schema: Mongo holds ingestion/raw (L0–L2.5);
// Neon holds the final processed/serving data (output, profile).
model Profile {
  id            String   @id @default(uuid())
  username      String   @unique
  displayName   String
  bio           String?
  avatarUrl     String?
  coverImageUrl String?
  socialLinks   Json?    // Array of { platform, url }
  sections      Json?    // Array of { id, type, title, content, settings }
  theme         Json?    // { primaryColor, accentColor, font, mode }
  isPublished   Boolean  @default(false)
  test_run_id   String   @default("PROD")
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@index([test_run_id])
  @@map("profiles")
}

// ═══════════════════════════════════════════════════════════════════
// L0–L2.5 — migrated from MongoDB (2026-07): ingestion, memory, signals,
// semantic graph, system. Field/table names preserved verbatim so call
// sites were a pure client swap. IDs are uuid (fresh start; Atlas is a
// cold archive). Embeddings use pgvector (vector(1536) + HNSW index).
// ═══════════════════════════════════════════════════════════════════

// --- LAYER 1: MEMORY ---

model MemoryPacket {
  id                String   @id @default(uuid())
  type              String
  source            String
  source_id         String

  content           Json
  metadata          Json

  event_time        DateTime
  ingestion_time    DateTime @default(now())
  last_updated      DateTime @updatedAt

  ownership         String   @default("self")
  sensitivity       String   @default("normal") // normal | restricted

  priority          String   @default("medium") // low | medium | high | critical
  confidence        Float    @default(1.0)

  status            String   @default("active") // active | partial | failed | archived
  hash              String

  trace             Json     // { origin, ingestion_path, parent_origin_id, retry_count, error_reason }

  embedding_status  String   @default("pending") // pending | processing | embedded | failed
  processing_status String   @default("pending") // pending | retrying | failed | complete
  semantic_status   String   @default("pending") // pending | processing | completed | partial | failed

  processing_lock   Boolean  @default(false)
  locked_at         DateTime?

  attempt_count     Int      @default(0)
  max_retries       Int      @default(3)
  next_retry_at     DateTime?
  last_retried_at   DateTime?
  retry_classification String? // llm_failure | parse_error | db_error

  fallback_used     Boolean  @default(false)

  is_embeddable     Boolean  @default(true)
  schema_version    Int      @default(2)
  processing_errors Json?    // Array of error objects [{ time, reason, level }]
  semantic_errors   Json?    // Array of error objects [{ time, reason, level }]

  test_run_id       String   @default("PROD")

  @@index([source])
  @@index([type])
  @@index([ingestion_time])
  @@index([status])
  @@index([embedding_status])
  @@index([processing_status])
  @@index([semantic_status])
  @@index([test_run_id])
  @@index([processing_lock])
  @@index([hash])
  @@map("memory_packets")
}

model Source {
  id              String   @id @default(uuid())
  name            String
  type            String   // system | manual | external

  trust_score     Float    @default(0.5)
  priority_level  String   @default("medium") // high | medium | low

  auth_status     String   @default("disconnected")
  last_sync       DateTime?
  failure_count   Int      @default(0)

  @@index([name])
  @@map("sources")
}

model ActivityStream {
  id            String   @id @default(uuid())
  packet_id     String
  activity_type String
  timestamp     DateTime @default(now())

  intensity     Float?   @default(0.5)
  source        String?
  metadata      Json
  test_run_id   String   @default("PROD")

  @@index([packet_id])
  @@index([timestamp])
  @@index([test_run_id])
  @@map("activity_stream")
}

model Signal {
  id                 String   @id @default(uuid())
  packet_id          String
  type               String
  category           String
  source             String

  intensity_absolute Float
  intensity_relative Float
  confidence         Float
  source_trust       Float

  timestamp          DateTime
  signal_hash        String   @unique
  metadata           Json
  test_run_id        String   @default("PROD")
  processing_state   String   @default("complete")

  @@index([packet_id])
  @@index([type])
  @@index([timestamp])
  @@index([test_run_id])
  @@index([processing_state])
  @@map("signals")
}

model Pattern {
  id                String   @id @default(uuid())
  type              String
  window_type       String   // 7d | 30d | all
  confidence        Float
  signal_count      Int
  consistency_score Float
  last_detected     DateTime @default(now())
  metadata          Json
  test_run_id       String   @default("PROD")
  processing_state  String   @default("complete")

  @@index([type])
  @@index([window_type])
  @@index([test_run_id])
  @@index([processing_state])
  @@map("patterns")
}

// --- DOCUMENTS & ASSETS ---

model Document {
  id           String   @id @default(uuid())
  packet_id    String
  file_name    String
  file_type    String
  file_url     String
  size_bytes   Int
  is_sensitive Boolean  @default(false)
  metadata     Json?
  test_run_id  String   @default("PROD")

  @@index([packet_id])
  @@index([test_run_id])
  @@map("documents")
}

model IngestionLog {
  id            String   @id @default(uuid())
  packet_id     String?
  decision      String   // ACCEPT | HOLD | REDIRECT | REJECT
  reason        String
  timestamp     DateTime @default(now())
  raw_payload   Json?
  test_run_id   String   @default("PROD")

  @@index([timestamp])
  @@index([test_run_id])
  @@map("ingestion_logs")
}

// Renamed from Mongo's RetryQueue — the L5 RetryQueue keeps retry_queue.
model PacketRetryQueue {
  id            String   @id @default(uuid())
  packet_id     String
  retry_count   Int      @default(0)
  last_attempt  DateTime?
  status        String   @default("pending") // pending | failed
  next_retry_at DateTime?
  test_run_id   String   @default("PROD")

  @@index([status])
  @@index([next_retry_at])
  @@index([test_run_id])
  @@map("packet_retry_queue")
}

model Embedding {
  id              String   @id @default(uuid())
  packet_id       String
  // pgvector column — written/queried via raw SQL (Prisma can't bind
  // Unsupported types). HNSW cosine index created in migration SQL.
  embedding       Unsupported("vector(1536)")?
  text_chunk      String
  metadata        Json
  test_run_id     String   @default("PROD")

  @@index([packet_id])
  @@index([test_run_id])
  @@map("embeddings")
}

// --- SYSTEM ---

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password_hash String
  role          String   @default("user")
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@map("users")
}

model SystemLog {
  id         String   @id @default(uuid())
  level      String   @default("info")
  message    String
  user_id    String?
  metadata   Json?
  created_at DateTime @default(now())

  @@index([created_at])
  @@map("system_logs")
}

model SystemSettings {
  id                String   @id @default(uuid())
  key               String   @unique // e.g., "global_config"
  value             Json     // { semantic_enabled, rag_enabled, model_override }
  last_updated      DateTime @updatedAt

  @@map("system_settings")
}

// --- LAYER 2.5: SEMANTIC ENRICHMENT ---

model SemanticObject {
  id                String   @id @default(uuid())
  packet_id         String

  entities          Json     // Array of { name, type, confidence, entity_id }
  intents           Json     // Array of { intent, confidence }
  topics            Json     // Array of { topic, confidence }

  model             String   @default("gpt-4o-mini")
  confidence        Float
  verification_status String   @default("verified") // verified | unverified
  fallback          Boolean  @default(false)
  processing_state  String   @default("complete") // pending | complete (atomicity)
  timestamp         DateTime @default(now())
  test_run_id       String   @default("PROD")

  @@index([packet_id])
  @@index([test_run_id])
  @@index([processing_state])
  @@map("semantic_objects")
}

model Entity {
  id                String   @id @default(uuid())
  name              String
  normalized_name   String
  type              String   // person | company | concept | tool | other
  confidence        Float
  verified          Boolean  @default(false)
  fallback          Boolean  @default(false)

  packet_ids        String[]
  source_chunk_ids  String[] // Same as packet_ids but follows spec
  occurrences       Int      @default(1)
  last_seen         DateTime @default(now())

  embedding         Float[]  // 1536 dimension for similarity
  metadata          Json?    // { source_count: number, last_seen_at: Date }

  processing_state  String   @default("complete") // pending | complete (atomicity)
  source_type       String   @default("llm")     // llm | fallback
  dedup_hash        String   // hash(normalized_name + type)

  test_run_id       String   @default("PROD")

  aliases           EntityAlias[]

  @@unique([normalized_name, type, test_run_id])
  @@index([dedup_hash])
  @@index([type])
  @@index([test_run_id])
  @@index([processing_state])
  @@index([verified])
  @@map("entities")
}

model EntityAlias {
  id                String   @id @default(uuid())
  entity_id         String
  alias             String
  confidence        Float
  test_run_id       String   @default("PROD")

  entity            Entity      @relation(fields: [entity_id], references: [id])

  @@index([alias, test_run_id])
  @@index([entity_id])
  @@map("entity_aliases")
}

model Relationship {
  id                String   @id @default(uuid())
  from_entity_id    String
  to_entity_id      String
  type              String   // uses | works_at | related_to | etc.

  confidence        Float
  verified          Boolean  @default(false)

  source_chunk_ids  String[]
  timestamp         DateTime @default(now())

  processing_state  String   @default("complete") // pending | complete (atomicity)
  dedup_hash        String   // hash(from_id + to_id + type)

  test_run_id       String   @default("PROD")

  @@unique([dedup_hash, test_run_id])
  @@index([from_entity_id])
  @@index([to_entity_id])
  @@index([test_run_id])
  @@index([processing_state])
  @@map("relationships")
}

model PendingEdge {
  id              String   @id @default(uuid())
  from_temp       String   // from_name
  to_temp         String   // to_name
  type            String
  confidence      Float    // weight
  source_chunk_id String

  test_run_id     String   @default("PROD")
  created_at      DateTime @default(now())

  @@index([test_run_id])
  @@map("pending_edges")
}

model Topic {
  id                String   @id @default(uuid())
  name              String
  strength          Float
  packet_ids        String[]
  last_updated      DateTime @default(now())

  processing_state  String   @default("complete") // pending | complete (atomicity)
  test_run_id       String   @default("PROD")

  @@unique([name, test_run_id])
  @@index([processing_state])
  @@index([test_run_id])
  @@map("topics")
}

// --- LAYER 0: QUARANTINE (Blob Store) ---

model BlobItem {
  id          String   @id @default(uuid())
  type        String
  source      String
  source_id   String?
  raw_payload Json
  file_ref    String?
  size        Int
  hash        String
  state       String   @default("raw")
  trace_json  Json
  owner_id    String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  expires_at  DateTime?
  test_run_id String   @default("PROD")
  events      BlobEvent[]

  @@index([hash])
  @@index([state])
  @@index([test_run_id])
  @@map("blob_items")
}

model BlobEvent {
  id         String   @id @default(uuid())
  blob_id    String
  event_type String
  actor      String?
  payload    Json?
  created_at DateTime @default(now())

  blob       BlobItem @relation(fields: [blob_id], references: [id], onDelete: Cascade)

  @@index([blob_id])
  @@map("blob_events")
}

// Distributed rate-limit counters (Neon-backed so limits hold across
// serverless instances — the prior in-memory Map reset per cold start).
model RateLimitCounter {
  key       String   @id
  count     Int      @default(1)
  resetAt   DateTime

  @@map("rate_limit_counters")
}

// Pulse — direct wellbeing/momentum check-ins (src/lib/pulse/*). Not tied to
// a memory packet, so it's its own table rather than reusing Signal.
model PulseCheckin {
  id            String   @id @default(uuid())
  userId        String
  motivation    Float
  energy        Float
  stress        Float
  attention     Float
  burnoutRisk   Float
  flagged       Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
  @@map("pulse_checkins")
}
