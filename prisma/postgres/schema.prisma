generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/postgres"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model DecisionLog {
  id           String   @id @default(uuid())
  userId       String
  mode         String   // architect | founder | operator

  contextJson  Json
  outputJson   Json

  confidence   Float
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@map("decision_logs")
}

model FeedbackLog {
  id           String   @id @default(uuid())
  decisionId   String
  userId       String
  feedbackType String   // accepted | ignored | rejected
  comment      String?
  createdAt    DateTime @default(now())

  @@index([decisionId])
  @@index([userId])
  @@map("feedback_logs")
}

// L3 Opportunity Engine — stores every /cognitive/evaluate run
model OpportunityEvaluation {
  id             String   @id @default(uuid())
  userId         String
  inputText      String   // the JD, brief, or idea text submitted
  evaluationJson Json     // full output: fit_score, verdict, why_yes, why_no, action_items
  fitScore       Float    @default(0.0)
  mode           String   @default("architect")
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@map("opportunity_evaluations")
}

model BehaviorModel {
  id          String   @id @default(uuid())
  userId      String
  modelType   String   // decision_model | habit_model | attention_model
  key         String
  value       Json
  confidence  Float    @default(0.5)
  occurrences Int      @default(1)
  sourceIds   String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, modelType, key])
  @@map("behavior_models")
}

model TraitScore {
  id          String   @id @default(uuid())
  userId      String
  trait       String   // analytical | reactive | structured | etc.
  score       Float
  confidence  Float    @default(0.5)
  occurrences Int      @default(1)
  sourceIds   String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, trait])
  @@map("trait_scores")
}

model Preference {
  id          String   @id @default(uuid())
  userId      String
  category    String   // communication | work | content | scheduling
  key         String
  value       Json
  explicit    Boolean  @default(false)
  confidence  Float    @default(0.6)
  occurrences Int      @default(1)
  sourceIds   String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, category, key])
  @@map("preferences")
}

model StylePattern {
  id         String   @id @default(uuid())
  userId     String
  pattern    String   // e.g. "removes passive voice"
  frequency  Int      @default(1)
  confidence Float    @default(0.5)
  lastSeen   DateTime @default(now())

  @@unique([userId, pattern])
  @@map("style_patterns")
}

model PersonaProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  displayName        String?
  communicationStyle Json?
  writingStyle       Json?
  decisionStyle      Json?
  confidenceScore    Float    @default(0.5)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("persona_profiles")
}

model BehavioralTrait {
  id            String   @id @default(uuid())
  userId        String
  traitName     String
  traitValue    Float    @default(0.5)
  confidence    Float    @default(0.5)
  evidenceCount Int      @default(0)
  sourceLayer   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, traitName])
  @@index([userId])
  @@map("behavioral_traits")
}

model CommunicationPattern {
  id           String   @id @default(uuid())
  userId       String
  patternType  String?
  patternValue Json?
  confidence   Float    @default(0.5)
  sampleCount  Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([userId, patternType])
  @@map("communication_patterns")
}

model PreferenceMemory {
  id         String   @id @default(uuid())
  userId     String
  category   String?
  key        String?
  value      Json?
  confidence Float    @default(0.5)
  source     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([userId, category, key])
  @@map("preference_memory")
}

model OutputFingerprint {
  id               String   @id @default(uuid())
  userId           String
  sourceType       String?
  sourceId         String?
  styleVector      Json?
  aiProbability    Float    @default(0)
  humanProbability Float    @default(1)
  verifiedHuman    Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@index([userId])
  @@index([userId, sourceType, sourceId])
  @@map("output_fingerprints")
}

model PersonaEvolutionLog {
  id              String   @id @default(uuid())
  userId          String
  changedField    String?
  oldValue        Json?
  newValue        Json?
  reason          String?
  confidenceDelta Float?
  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
  @@map("persona_evolution_logs")
}

model FeedbackMemory {
  id           String   @id @default(uuid())
  userId       String
  targetType   String?
  targetId     String?
  feedbackType String?
  notes        String?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([userId, targetType, targetId])
  @@map("feedback_memory")
}

model AdaptiveUxProfile {
  id                       String   @id @default(uuid())
  userId                   String   @unique
  uiDensity                String   @default("minimal")
  preferredMode            String?
  preferredOutputLength    String?
  preferredNavigationStyle String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@map("adaptive_ux_profiles")
}

model OutputLog {
  id              String   @id @default(uuid())
  userId          String
  decisionId      String?  // Link to L3 decision
  platform        String   // linkedin | blog | memo | other
  content         String
  status          String   @default("draft") // draft | pushed
  personaSnapshot Json?    // Snapshot of L4 traits used for this generation
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([decisionId])
  @@map("output_logs")
}
